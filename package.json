{
  "name": "dispatch-envelope",
  "version": "0.1.0",
  "private": true,
  "description": "Dispatch Envelope — Prove whether a building's flexible loads fit inside a capped supply — and prove exactly why not.",
  "license": "MIT",
  "author": "aniruddhaadak80",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/dispatch-envelope.git"
  },
  "homepage": "https://github.com/aniruddhaadak80/dispatch-envelope",
  "bugs": {
    "url": "https://github.com/aniruddhaadak80/dispatch-envelope/issues"
  },
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "prepare": "prettier --write .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev --parallel",
    "check:skill-version": "node scripts/check-skill-version.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:readme-commands": "node scripts/check-readme-commands.mjs",
    "check:fixtures": "node scripts/gen-fixtures.mjs --check",
    "check:e2e": "node scripts/e2e-mcp.mjs",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "e2e": "node scripts/e2e-mcp.mjs",
    "pytest": "python -m pytest services/engine -q",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:skill-version && npm run check:no-secrets && npm run check:theme-tokens && npm run check:boundaries && npm run check:public-hygiene && npm run check:readme-commands && npm run check:fixtures && npm test && npm run pytest && npm run build && npm run check:e2e",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "cli",
    "typescript",
    "python",
    "self-hosted"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
